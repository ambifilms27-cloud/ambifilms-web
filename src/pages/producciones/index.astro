---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectFilter from '../../components/ProjectFilter.astro';
import { getCollection } from 'astro:content';

const proyectos = (await getCollection('proyectos')).sort(
	(a, b) => b.data.fecha.getTime() - a.data.fecha.getTime(),
);

const categorias = [...new Set(proyectos.map((p) => p.data.categoria))];
---

<Layout
	title="Producciones — Ambi Films"
	description="Portafolio de trabajos audiovisuales de Ambi Films: cortometrajes, videos musicales, comerciales y más."
>
	<section class="bg-ambi-dark pt-32 pb-24 sm:pt-40 sm:pb-32">
		<div class="mx-auto max-w-7xl px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<p class="text-xs tracking-[0.35em] text-ambi-gold uppercase">Portafolio</p>
				<h1 class="mt-4 font-serif text-5xl font-light tracking-wide text-white sm:text-6xl">
					Producciones
				</h1>
				<p class="mt-4 text-sm leading-relaxed text-ambi-muted">
					Una selección de nuestros trabajos en cine, música y publicidad.
				</p>
			</div>

			{
				proyectos.length > 0 ? (
					<>
						<div class="mt-12">
							<ProjectFilter categorias={categorias} />
						</div>

						<div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
							{proyectos.map((proyecto) => (
								<ProjectCard proyecto={proyecto} />
							))}
						</div>
					</>
				) : (
					<div class="mt-16 border border-white/5 bg-ambi-surface/30 px-8 py-16 text-center">
						<p class="font-serif text-2xl text-white/80">Próximamente</p>
						<p class="mt-3 text-sm text-ambi-muted">
							Estamos preparando nuestro portafolio. Vuelve pronto.
						</p>
					</div>
				)
			}
		</div>
	</section>
</Layout>
